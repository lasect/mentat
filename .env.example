MENTAT_API_ADDRESS=:8080
MENTAT_DATABASE_URL=postgres://mentat:mentat@localhost:5432/mentat?sslmode=disable
MENTAT_FRONTEND_AUTH_CALLBACK_URL=http://localhost:5173/auth/callback
MENTAT_ALLOWED_ORIGINS=http://localhost:5173
# Comma-separated proxy network CIDRs. Leave empty unless the API is behind
# proxies that append X-Forwarded-For (for example: 10.0.0.0/8,fd00::/8).
MENTAT_TRUSTED_PROXY_CIDRS=
MENTAT_COOKIE_SECURE=false
MENTAT_COOKIE_DOMAIN=

# Base64-encoded Ed25519 seed (32 bytes) or private key (64 bytes).
MENTAT_JWT_PRIVATE_KEY=
MENTAT_JWT_ISSUER=mentat-api
MENTAT_JWT_AUDIENCE=mentat

# Independent base64-encoded 32-byte values.
MENTAT_OAUTH_COOKIE_AUTH_KEY=
MENTAT_OAUTH_COOKIE_BLOCK_KEY=

# Base64-encoded 32-byte AES-256 key for monitored database connections.
MENTAT_CONNECTION_ENCRYPTION_KEY=

MENTAT_GITHUB_CLIENT_ID=
MENTAT_GITHUB_CLIENT_SECRET=
MENTAT_GITHUB_CALLBACK_URL=http://localhost:8080/v1/auth/oauth/github/callback

MENTAT_GOOGLE_CLIENT_ID=
MENTAT_GOOGLE_CLIENT_SECRET=
MENTAT_GOOGLE_CALLBACK_URL=http://localhost:8080/v1/auth/oauth/google/callback
