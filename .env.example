TETRA_API_ADDRESS=:8080
TETRA_DATABASE_URL=postgres://tetra:tetra@localhost:5432/tetra?sslmode=disable
TETRA_FRONTEND_AUTH_CALLBACK_URL=http://localhost:5173/auth/callback
TETRA_ALLOWED_ORIGINS=http://localhost:5173
# Comma-separated proxy network CIDRs. Leave empty unless the API is behind
# proxies that append X-Forwarded-For (for example: 10.0.0.0/8,fd00::/8).
TETRA_TRUSTED_PROXY_CIDRS=
TETRA_COOKIE_SECURE=false
TETRA_COOKIE_DOMAIN=

# Base64-encoded Ed25519 seed (32 bytes) or private key (64 bytes).
TETRA_JWT_PRIVATE_KEY=
TETRA_JWT_ISSUER=tetra-api
TETRA_JWT_AUDIENCE=tetra

# Independent base64-encoded 32-byte values.
TETRA_OAUTH_COOKIE_AUTH_KEY=
TETRA_OAUTH_COOKIE_BLOCK_KEY=

# Base64-encoded 32-byte AES-256 key for monitored database connections.
TETRA_CONNECTION_ENCRYPTION_KEY=

TETRA_GITHUB_CLIENT_ID=
TETRA_GITHUB_CLIENT_SECRET=
TETRA_GITHUB_CALLBACK_URL=http://localhost:8080/v1/auth/oauth/github/callback

TETRA_GOOGLE_CLIENT_ID=
TETRA_GOOGLE_CLIENT_SECRET=
TETRA_GOOGLE_CALLBACK_URL=http://localhost:8080/v1/auth/oauth/google/callback
